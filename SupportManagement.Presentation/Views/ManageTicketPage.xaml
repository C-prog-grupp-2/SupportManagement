<Page
    x:Class="SupportManagement.Presentation.Views.ManageTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Background>
        <SolidColorBrush Color="#2F2F2F"/>
    </Page.Background>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <!-- Rubrik -->
            <RowDefinition Height="Auto"/>

            <!-- Information om ticket -->
            <RowDefinition Height="Auto"/>

            <!-- Kommentarer tar resten av utrymmet -->
            <RowDefinition Height="*"/>

            <!-- Knappar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- RUBRIK -->
        <TextBlock
            Grid.Row="0"
            Text="TicketDetails"
            Style="{StaticResource PageTitleStyle}"
            Margin="0,0,0,25"/>


        <!-- INFORMATION OM TICKET -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Titel -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Titel:"
                FontWeight="Bold"
                Margin="0,0,15,10"/>

            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding Ticket.Title, Mode=TwoWay}"
                Margin="0,0,0,10"/>


            <!-- Beskrivning -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="Beskrivning:"
                FontWeight="Bold"
                Margin="0,0,15,10"/>

            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Height="70"
                Text="{Binding Ticket.Description, Mode=TwoWay}"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="0,0,0,10"/>


            <!-- Kund -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Kund:"
                FontWeight="Bold"
                Margin="0,0,15,10"/>

            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding Customer.Name}"
                Margin="0,0,0,10"/>


            <!-- Prioritet -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Prioritet:"
                FontWeight="Bold"
                Margin="0,0,15,10"/>

            <ComboBox
                Grid.Row="3"
                Grid.Column="1"
                Width="200"
                HorizontalAlignment="Left"
                Margin="0,0,0,10">

                <ComboBoxItem Content="Low"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="High"/>

            </ComboBox>


            <!-- Status -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Text="Status:"
                FontWeight="Bold"
                Margin="0,0,15,10"/>

            <ComboBox
                Grid.Row="4"
                Grid.Column="1"
                Width="200"
                HorizontalAlignment="Left"
                Margin="0,0,0,10">

                <ComboBoxItem Content="New"/>
                <ComboBoxItem Content="InProgress"/>
                <ComboBoxItem Content="Resolved"/>

            </ComboBox>


            <!-- Tekniker -->
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="Tekniker:"
                FontWeight="Bold"
                Margin="0,0,15,0"/>

            <ComboBox
                Grid.Row="5"
                Grid.Column="1"
                Width="200"
                HorizontalAlignment="Left">

                <ComboBoxItem Content="Anna"/>
                <ComboBoxItem Content="Erik"/>
                <ComboBoxItem Content="Johan"/>

            </ComboBox>

        </Grid>


        <!-- KOMMENTARER -->
        <Border
            Grid.Row="2"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="5"
            Padding="15"
            Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Kommentar-rubrik -->
                    <RowDefinition Height="Auto"/>

                    <!-- Lista med kommentarer -->
                    <RowDefinition Height="*"/>

                    <!-- Ny kommentar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Kommentar-rubrik -->
                <TextBlock
                    Grid.Row="0"
                    Text="Kommentarer"
                    Style="{StaticResource SectionTitleStyle}"
                    Margin="0,0,0,10"/>


                <!-- Lista med kommentarer -->
                <ListBox
                    Grid.Row="1"
                    Margin="0,0,0,15"/>


                <!-- Ny kommentar -->
                <Grid
                    Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBox
                        Grid.Column="0"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <Button
                        Content="Lägg till kommentar"
                        Style="{StaticResource CommentButtonStyle}"
                        Margin="10,0,0,0"/>

                </Grid>

            </Grid>

        </Border>


        <!-- KNAPPAR -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Spara"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,0,10,0"/>

            <Button
                Content="Tillbaka"
                Style="{StaticResource SecondaryButtonStyle}"/>

        </StackPanel>

    </Grid>

</Page>