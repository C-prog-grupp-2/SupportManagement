<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportManagement.Presentation.Views.TicketDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SupportManagement.Domain.Models">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24">

            <TextBlock
                Text="Ärendedetaljer"
                Style="{StaticResource PageTitleStyle}"/>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Left"/>

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="IndianRed"
                TextWrapping="Wrap"/>



            <StackPanel
                DataContext="{x:Bind ViewModel.Ticket, Mode=OneWay}"
                Spacing="16">

                <TextBlock
                    Text="{Binding Title}"
                    Style="{StaticResource SectionTitleStyle}"
                    TextWrapping="Wrap"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Kund" FontWeight="SemiBold"/>
                    <TextBlock
                    Text="{x:Bind ViewModel.CustomerName, Mode=OneWay}"
                    TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Beskrivning" FontWeight="SemiBold"/>
                    <TextBlock
                        Text="{Binding Description}"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Status" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Prioritet" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Priority}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Skapad (UTC)" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAtUtc}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Ansvarig tekniker"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="{Binding ResponsibleTechnician,
                               TargetNullValue='Ingen tilldelad'}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Ärende-ID" FontWeight="SemiBold"/>
                    <TextBlock
                        Text="{Binding Id}"
                        IsTextSelectionEnabled="True"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Kund-ID" FontWeight="SemiBold"/>
                    <TextBlock
                        Text="{Binding CustomerId}"
                        IsTextSelectionEnabled="True"/>
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.CommentsHeading, Mode=OneWay}"
                    Style="{StaticResource SectionTitleStyle}"/>

                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Comment">
                            <StackPanel Spacing="6" Margin="0,0,0,16">
                                <TextBlock
                                    Text="{x:Bind CommentContent}"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    Text="{x:Bind CommentCreatedAtUtc}"
                                    Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button
                Content="Tillbaka"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{x:Bind ViewModel.GoBackCommand}"/>

        </StackPanel>
    </ScrollViewer>
</Page>