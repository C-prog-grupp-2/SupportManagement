<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportManagement.Presentation.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:models="using:SupportManagement.Domain.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--KUNDREGISTER-->
    
    <Grid Padding="24">
                    
        <StackPanel Spacing="20">
            
            
          <!--SIDRUBRIK OCH LÄGG TILL NY KYND-->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
              <!--Rubrik och beskrivning-->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Kundregister"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock Text="Hantera registrerade kunder och kontaktuppgifter"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="WrapWholeWords"/>

                </StackPanel>
                
                <!--Ny kund-knapp-->
                <Button Grid.Column="1"
                        Content="+ Ny kund"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="110"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.GoToCreateCustomerCommand}"/>
                
            </Grid>
            
                        
            <!--KUNDLISTA-->

            <TextBlock Text="Registerade kunder"
                      Style="{StaticResource SectionTitleStyle}" />
             
            
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="=Namn/ Företag"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1"
                           Text="E-postadress"
                           FontWeight="SemiBold"/>

            </Grid>


                <!--LISTA MED KUNDER-->
            <ListView ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}">


                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Customer">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name}" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Email}" />
                            
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
           
            
            <!--KNAPPAR FÖR VALD KUND-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">

                <Button Content="Redigera"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Ta bort"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DeleteCustomer_Click"/>


            </StackPanel>


            <!--FELMEDDELANDEN-->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage,Mode=OneWay}"
                       Foreground="IndianRed"
                       TextWrapping="WrapWholeWords" />

        </StackPanel>
    </Grid>
</Page>
