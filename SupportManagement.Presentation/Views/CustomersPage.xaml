<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportManagement.Presentation.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:models="using:SupportManagement.Domain.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportManagement.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--KUNDREGISTER-->
    
    <Grid Padding="24">
                    
        <StackPanel Spacing="20">
            
          <!--SIDRUBRIK OCH LÄGG TILL NY KYND-->

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
              <!--Rubrik och beskrivning-->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Kundregister"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Hantera registrerade kunder och kontaktuppgifter"
                               FontSize="14"
                               TextWrapping="WrapWholeWords"/>

                </StackPanel>
                
                <!--Ny kund-knapp-->

                <Button Grid.Column="1"
                        Content="+ Ny kund"
                        Width="110"
                        Height="40"
                        VerticalAlignment="Center"/>
            </Grid>
            
            
            
            <!--KUNDLISTA-->

            <TextBlock Text="Registerade kunder"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            
            <!--Kolumnrubriker-->
           
        </StackPanel>
    </Grid>
</Page>
