<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportManagement.Presentation.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <TextBlock
                Text="Välkommen till Super Support!"
                Style="{StaticResource PageTitleStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <TextBlock
                Text="Hantera kunder och supportärenden."
                Style="{StaticResource BodyTextStyle}"
                TextAlignment="Center"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12"
                Margin="0,8,0,0">

                <Button
                    Content="Kunder"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Bind ViewModel.GoToCustomersCommand}"/>

                <Button
                    Content="Ärenden"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Bind ViewModel.GoToTicketsCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
